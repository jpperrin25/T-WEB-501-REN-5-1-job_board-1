{% extends 'base.html.twig' %}

{% block title %}Accès refusé (403) | JobBoard{% endblock %}

{% block body %}
<div class="error-page-container profile-edit-page">
    <div class="profile-edit-card error-card">
        
        <div class="error-icon-box error-icon-danger">
            🔒
        </div>

        <div class="profile-edit-heading" style="margin-bottom: 24px;">
            <span class="profile-edit-eyebrow" style="color: var(--danger);">ERREUR 403</span>
            <h1 style="margin-bottom: 12px;">Accès refusé</h1>
            <p style="max-width: 480px; margin: 0 auto; color: var(--muted); font-size: 0.98rem; line-height: 1.6;">
                Vous n'avez pas les autorisations nécessaires pour accéder à cette page.
            </p>
        </div>

        <div class="error-actions-wrapper">
            <a href="{{ path('app_job_index') }}" class="applications-back">
                🏠 Retour à l'accueil
            </a>
        </div>

    </div>
</div>
{% endblock %}