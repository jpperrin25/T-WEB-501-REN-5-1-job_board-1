{% extends 'base.html.twig' %}

{% block title %}Modifier l'offre | JobBoard{% endblock %}

{% block body %}
<div class="profile-edit-page">
    <div class="profile-edit-card">

        {# En-tête de la carte #}
        <div class="profile-edit-card-heading">
            <div class="profile-edit-icon">
                ✏️
            </div>
            <div>
                <h2>Modifier l'offre d'emploi</h2>
                <p>Mettez à jour les informations de votre annonce</p>
            </div>
        </div>

        {# Formulaire principal de modification #}
        <div class="profile-edit-form">
            {{ include('job/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
        </div>

        {# Zone d'actions du bas : Retour et Suppression réparties proprement #}
        <div class="public-modal-facts">
            <div>
                {{ include('job/_delete_form.html.twig') }}
            </div>
        </div>

    </div>
</div>
{% endblock %}