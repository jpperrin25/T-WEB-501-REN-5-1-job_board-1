{% extends 'base.html.twig' %}

{% block title %}{{ job.title }} — JobBoard{% endblock %}

{% block body %}
    <main class="job-detail-page container">

        <a class="job-detail-back" href="{{ path('app_job_index') }}">
            <span aria-hidden="true">←</span>
            Retour aux offres
        </a>

        <header class="job-detail-hero">
            <div class="job-detail-main">
                <p class="job-detail-eyebrow">OPPORTUNITÉ PROFESSIONNELLE</p>

                <h1>{{ job.title }}</h1>

                {% if job.company %}
                    <a
                        class="job-detail-company"
                        href="{{ path('app_company_show', {id: job.company.id}) }}"
                    >
                        {{ job.company.name }} <span aria-hidden="true">↗</span>
                    </a>
                {% else %}
                    <p class="job-detail-company">Entreprise non précisée</p>
                {% endif %}

                <div class="job-detail-tags">
                    <span class="job-detail-tag">
                        {{ job.city ?: job.address ?: 'Lieu à préciser' }}
                    </span>

                    {% if job.type %}
                        <span class="job-detail-tag">{{ job.type }}</span>
                    {% endif %}

                    {% if job.schedule %}
                        <span class="job-detail-tag">{{ job.schedule }}</span>
                    {% endif %}
                </div>
            </div>

            <div class="job-detail-salary">
                <span>Rémunération annuelle</span>
                <strong>
                    {% if job.salary and job.salary > 0 %}
                        {{ job.salary|number_format(0, ',', ' ') }} €
                    {% else %}
                        Non renseignée
                    {% endif %}
                </strong>
                {% if job.salary and job.salary > 0 %}
                    <small>Salaire annuel indiqué</small>
                {% endif %}
            </div>
            {% if is_granted('ROLE_ADMIN') or ownJob %}
                <a class="job-login-link" href="{{ path('app_job_edit', {id: job.id}) }}">
                    Modifier l'offre
                </a>
                {% include "job/_delete_form.html.twig" %}
            {% endif %}

        </header>

        <div class="job-detail-layout">
            <article class="job-detail-panel">
                <p class="job-detail-kicker">LE POSTE</p>
                <h2>Description du poste</h2>
                <div class="job-detail-description">
                    {{ job.description ?: 'Aucune description disponible pour cette offre.' }}
                </div>
                
                {% if not app.user %}
                    <a class="job-login-link" href="{{ path('secu.login') }}">
                        Se connecter pour postuler
                    </a>
                {% endif %}
            </article>

            <aside class="job-detail-panel job-detail-sidebar">
                <p class="job-detail-kicker">LES ESSENTIELS</p>
                <h2>Informations sur le poste</h2>
 
                
                <dl class="job-detail-info">
                    <div>
                        <dt>Entreprise</dt>
                        <dd>{{ job.company ? job.company.name : 'Non précisée' }}</dd>
                    </div>

                    <div>
                        <dt>Lieu</dt>
                        <dd>{{ job.city ?: job.address ?: 'Non précisé' }}</dd>
                    </div>

                    {% if job.postalCode %}
                        <div>
                            <dt>Code postal</dt>
                            <dd>{{ job.postalCode }}</dd>
                        </div>
                    {% endif %}

                    <div>
                        <dt>Contrat</dt>
                        <dd>{{ job.type ?: 'Non précisé' }}</dd>
                    </div>

                    <div>
                        <dt>Horaires</dt>
                        <dd>{{ job.schedule ?: 'Non précisés' }}</dd>
                    </div>

                    <div>
                        <dt>Rémunération</dt>
                        <dd>
                            {% if job.salary and job.salary > 0 %}
                                {{ job.salary|number_format(0, ',', ' ') }} € / an
                            {% else %}
                                Non renseignée
                            {% endif %}
                        </dd>
                    </div>
                </dl>

                {% if job.company %}
                    <a
                        class="job-detail-company-button"
                        href="{{ path('app_company_show', {id: job.company.id}) }}"
                    >
                        <span>Voir l’entreprise</span>
                        <span aria-hidden="true">→</span>
                    </a>
                {% endif %}

                <a
                    class="job-detail-all-jobs"
                    href="{{ path('app_job_index') }}"
                >
                    Découvrir les autres offres
                </a>
            </aside>
        </div>
    </main>
{% endblock %}
