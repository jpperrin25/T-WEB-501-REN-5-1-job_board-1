<aside class="dashboard-sidebar">
    <a href="{{ path('app_job_index') }}" class="dashboard-brand">
        JobBoard
    </a>


    <p class="dashboard-sidebar-label">
        {% if is_granted('ROLE_COMPANY')%}
            ESPACE ENTREPRISE
        {% elseif is_granted('ROLE_ADMIN')%}
            ADMINISTRATION
        {% else %}
            ESPACE CANDIDAT
        {% endif %}
    </p>

    <nav class="dashboard-sidebar-nav" aria-label="Navigation du tableau de bord">
        {% if is_granted('ROLE_COMPANY') %}
            <a href="{{ path('app_user_edit', {id: app.user.id}) }}" class="dashboard-nav-link">
                <span aria-hidden="true">♙</span>
                Modifier mon profil
            </a>
            <a href="{{ path('app_company_index') }}" class="dashboard-nav-link">
                <span aria-hidden="true">▦</span>
                Entreprises
            </a>
            <a href="{{ path('app_job_index') }}" class="dashboard-nav-link">
                <span aria-hidden="true">▤</span>
                Mes offres
            </a>
            <a href="{{ path('app_user_applications') }}" class="dashboard-nav-link">
                <span aria-hidden="true">♧</span>
                Candidatures reçues
            </a>

        {% elseif is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_user_edit', {id: app.user.id}) }}" class="dashboard-nav-link">
                <span aria-hidden="true">♙</span>
                Modifier mon profil
            </a>
            <a href="{{ path('app_admin_users') }}" class="dashboard-nav-link">
                <span aria-hidden="true">♙</span>
                Utilisateurs
            </a>
            <a href="{{ path('app_company_index') }}" class="dashboard-nav-link">
                <span aria-hidden="true">▦</span>
                Entreprises
            </a>
            <a href="{{ path('app_job_index') }}" class="dashboard-nav-link">
                <span aria-hidden="true">▤</span>
                Offres d'emploi
            </a>
            <a href="{{ path('app_user_applications') }}" class="dashboard-nav-link">
                <span aria-hidden="true">♧</span>
                Candidatures
            </a>

        {% else %}
            <a href="{{ path('app_user_edit', {id: app.user.id}) }}" class="dashboard-nav-link">
                <span aria-hidden="true">♙</span>
                Modifier mon profil
            </a>
            <a href="{{ path('app_job_index') }}" class="dashboard-nav-link">
                <span aria-hidden="true">⌕</span>
                Parcourir les offres
            </a>
            <a href="{{ path('app_user_applications') }}" class="dashboard-nav-link">
                <span aria-hidden="true">♧</span>
                Mes candidatures
            </a>
            <a href="{{ path('app_company_index') }}" class="dashboard-nav-link">
                <span aria-hidden="true">▦</span>
                Entreprises
            </a>
            {# <span class="dashboard-sidebar-disabled">Offres enregistrées</span>
            <span class="dashboard-sidebar-disabled">Mes documents</span>
            <span class="dashboard-sidebar-disabled">Messagerie</span> #}
        {% endif %}
    </nav>

    {% if app.user %}
        <div class="dashboard-sidebar-heading">
            <span class="dashboard-avatar">
                {{ app.user.firstname|default('U')|first|upper }}
            </span>
            <div>
                <strong>
                    {{ app.user.firstname|default('') }}
                    {{ app.user.lastname|default('') }}
                </strong>
                <small>
                    {% if is_granted('ROLE_COMPANY') %}
                        Espace entreprise
                    {% elseif is_granted('ROLE_ADMIN')%}
                        Administration
                    {% else %}
                        Espace candidat
                    {% endif %}
                </small>
            </div>
        </div>
    {% endif %}
</aside>
